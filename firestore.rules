rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isAuthenticated() && getUserRole() == 'admin';
    }

    function isSupervisor() {
      return isAuthenticated() && (getUserRole() == 'admin' || getUserRole() == 'supervisor');
    }

    function isOfficer() {
      return isAuthenticated() && (getUserRole() == 'admin' || getUserRole() == 'supervisor' || getUserRole() == 'officer');
    }

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
      allow create: if isAdmin();
      allow delete: if isAdmin();
    }

    match /travelers/{travelerId} {
      allow read: if isOfficer();
      allow create: if isOfficer();
      allow update: if isOfficer();
      allow delete: if isAdmin();
    }

    match /crossings/{crossingId} {
      allow read: if isOfficer();
      allow create: if isOfficer();
      allow update: if isOfficer();
      allow delete: if isAdmin();
    }

    match /checkpoints/{checkpointId} {
      allow read: if isOfficer();
      allow write: if isAdmin();
    }

    match /devices/{deviceId} {
      allow read: if isOfficer();
      allow write: if isAdmin();
    }

    match /alerts/{alertId} {
      allow read: if isOfficer();
      allow write: if isAdmin();
    }

    match /audit_logs/{logId} {
      allow read: if isAdmin() || isSupervisor();
      allow create: if isOfficer();
      allow delete: if isAdmin();
    }

    match /roles/{roleId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /departments/{deptId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /crossing_queue/{itemId} {
      allow read: if isOfficer();
      allow write: if isOfficer();
    }
  }
}
